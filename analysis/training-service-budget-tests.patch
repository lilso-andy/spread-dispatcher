diff --git a/test/fixed-price.test.ts b/test/fixed-price.test.ts
index bb5b8e7..633a006 100644
--- a/test/fixed-price.test.ts
+++ b/test/fixed-price.test.ts
@@ -31,3 +31,34 @@ test("fixed-price fee estimates do not ratchet upward from the dispatcher's own
   const competitive = setup(8); competitive.observedBookings.set("a", Array(10).fill(1.85))
   assert.equal(competitive.feeMultiplier("a"), 1.9)
 })
+
+test("opted-in training keeps quoting at 5-8% historical lateness but pauses above 8%", () => {
+  for (const level of [1, 2, 3]) {
+    for (const [late, accepted] of [[5, true], [8, true], [9, false]] as const) {
+      const d = setup(level)
+      d.config.trainingEconomy = true
+      d.config.feeMultiplier = 0.86
+      for (let i = 0; i < 100; i++) d.orders.set(`done${i}`, {
+        id: `done${i}`, dealerId: "dealer", option: "same_day", priceCents: 10000,
+        deadline: 479, lastPickupAt: 300, legs: structuredClone(request.legs),
+        status: "delivered", deliveredAt: [i < late ? 480 : 479],
+      })
+      d.quote(structuredClone(request))
+      assert.equal(d.decisions.get(request.id)?.accepted, accepted, `level ${level}, ${late}% late`)
+    }
+  }
+})
+
+test("default training and market levels retain their 4.5% recovery pause", () => {
+  for (const level of [1, 2, 3, 4, 5, 6, 7, 8]) {
+    const d = setup(level)
+    d.config.trainingEconomy = level >= 4
+    for (let i = 0; i < 100; i++) d.orders.set(`done${i}`, {
+      id: `done${i}`, dealerId: "dealer", option: "same_day", priceCents: 10000,
+      deadline: 479, lastPickupAt: 300, legs: structuredClone(request.legs),
+      status: "delivered", deliveredAt: [i < 5 ? 480 : 479],
+    })
+    d.quote(structuredClone(request))
+    assert.equal(d.decisions.get(request.id)?.reason, "service recovery: pause new exposure")
+  }
+})
